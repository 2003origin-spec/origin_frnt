USER_DATABASE_URL=<postgres-url>
OGCODE_DATABASE_URL=<postgres-url>
# Comma-separated OTP-login allowlist for co-equal main admins. After changing
# this in Vercel, run scripts/seed-main-admin.mjs against USER_DATABASE_URL to
# persist is_main_admin=true for these emails and demote removed main admins.
PLATFORM_MAIN_ADMIN_EMAIL=adminoffice@o3origin.com,2003origin@gmail.com
# Used by npm run origin-ai:vectors:* scripts. Keep this as a normal postgres:// URL for Node.
ORIGIN_AI_DATABASE_URL=<postgres-url>
GRADER_SERVICE_URL=<grader-service-url>
GRADER_SERVICE_TOKEN=<grader-service-token>
GRADER_SERVICE_TIMEOUT_MS=<timeout-ms>
ANALYTICS_SERVICE_URL=<analytics-service-url>
ANALYTICS_SERVICE_TOKEN=<analytics-service-token>
ANALYTICS_SERVICE_TIMEOUT_MS=<timeout-ms>
ORIGIN_AI_SERVICE_URL=<origin-ai-service-url>
ORIGIN_AI_SERVICE_TOKEN=<origin-ai-service-token>
NEXT_PUBLIC_ORIGIN_AI_URL=<origin-ai-public-url>

# Phase 10 — document-import-service (FastAPI worker that runs the
# import pipeline: classifier → extractor → OCR → multimodal fallback
# → verifier → persistence). Next.js POSTs to {url}/v1/import-jobs/{id}/run
# right after the import.document_import_jobs row is inserted.
# Leaving either of these unset is fine in dev — the trigger silently
# no-ops and the job stays in `queued`.
DOCUMENT_IMPORT_SERVICE_URL=<document-import-service-url>
DOCUMENT_IMPORT_SERVICE_TOKEN=<document-import-service-token>
DOCUMENT_IMPORT_SERVICE_TIMEOUT_MS=<timeout-ms>

# Phase 12 — payment provider webhook secret. The provider posts
# /api/enrollments/orders?action=mark_paid|mark_payment_pending|mark_failed
# with `Authorization: Bearer $PAYMENT_WEBHOOK_TOKEN`. These actions
# refuse student-session auth so a logged-in student can't mark their
# own order paid.
PAYMENT_WEBHOOK_TOKEN=<32-plus-character-random-secret>

# Phase 13 — Free vs Premium per-subject subscriptions (Razorpay).
# Use test-mode keys + test plan ids in dev/staging and live keys in prod.
# The feature ships dark: set TEACHER_LAUNCH_PREMIUM_SUBSCRIPTIONS=1 to enable.
# Plan ids are created once with `node --env-file=.env.local scripts/seed-razorpay-plans.mjs`.
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>
RAZORPAY_PLAN_PHYSICS=<plan-id-for-physics>
RAZORPAY_PLAN_CHEMISTRY=<plan-id-for-chemistry>
RAZORPAY_PLAN_MATHEMATICS=<plan-id-for-mathematics>
RAZORPAY_PLAN_BIOLOGY=<plan-id-for-biology>
TEACHER_LAUNCH_PREMIUM_SUBSCRIPTIONS=0

# Teacher Live Rooms — real-time room shell (chat + typing + presence), 60s
# rotating / permanent join codes, kick + participant search (pg_trgm),
# Start-Test auto-stop, post-test leaderboard + analytics, and hard delete.
# Ships dark in prod: set TEACHER_LAUNCH_LIVE_ROOMS=1 to enable. On by default
# in dev. Requires ROOM_CODE_SECRET (>=32 chars) for join codes and, for the
# auto-stop sweep, INTERNAL_CRON_TOKEN (reused from the other internal drains).
TEACHER_LAUNCH_LIVE_ROOMS=0

# Student Social — LeetCode/GitHub-style follow: @username handles, public
# profiles at /u/<username> (rank + badges + Activity Vault + recent activity),
# follow/unfollow, follower/following lists, and student search (pg_trgm).
# Ships dark in prod: set TEACHER_LAUNCH_STUDENT_SOCIAL=1 to enable. On by
# default in dev. Schema auto-applies via src/server/social/social-schema.ts.
TEACHER_LAUNCH_STUDENT_SOCIAL=0

# ODG Phase 3 — marketplace teacher ranking (frontend-only gate). When 1, the
# public institutes list is re-ranked by ODG teacher activation scores from the
# analytics service; empty/failed ranking keeps the base order. Independent of
# the Cloud Run ODG_* backend flags — leave 0 until Phase 3 shadow data exists.
TEACHER_LAUNCH_ODG_TEACHER_RANKING=0

# Optional local AI Solver compatibility service. Leave empty unless running that service.
AI_SOLVER_SERVICE_URL=

# Production-only rate limiting backend. Leave unset for local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 object storage for uploaded/public media.
# Keep access keys server-only. Use a custom public hostname/CDN for images rendered by Next.
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_BUCKET_NAME=<r2-bucket-name>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://<media-domain>
NEXT_PUBLIC_R2_PUBLIC_HOSTNAME=<media-domain-hostname>

# Optional production metrics export.
METRICS_OTLP_HTTP_ENDPOINT=<metrics-otlp-http-endpoint>
METRICS_OTLP_HTTP_TOKEN=<metrics-otlp-http-token>

# Server-only secrets. Never expose these as NEXT_PUBLIC_*.
# Generate JWT secrets with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
AUTH_JWT_SECRET_CURRENT=<32-plus-byte-base64url-secret>
# Optional during key rotation. Keep only until old 10-minute access JWTs expire.
AUTH_JWT_SECRET_PREVIOUS=
ROOM_CODE_SECRET=<32-plus-character-random-secret>
OPTION_SHUFFLE_SECRET=<32-plus-character-random-secret>
INTERNAL_CRON_TOKEN=<32-plus-character-random-secret>

NEXT_PUBLIC_API_URL=<api-base-url>
NEXT_PUBLIC_SITE_URL=<public-site-url>
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
GEMINI_MODEL=<gemini-model>
GEMINI_STT_MODEL=<gemini-stt-model>
GEMINI_LIVE_MODEL=<gemini-live-model>
GEMINI_TTS_MODEL=<gemini-tts-model>
GEMINI_LIVE_VOICE_NAME=<gemini-voice-name>
ORIGIN_AI_PROVIDER_TIMEOUT_MS=<timeout-ms>

# Email Configuration (SMTP)
SMTP_HOST=<smtp-host>
SMTP_PORT=<smtp-port>
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-app-password>
EMAIL_FROM=<email-from>

# ─────────────────────────────────────────────────────────────────────────────
# Everything below was added so this file lists every env name read in src/.
# REQUIRED in hosted production = checked by src/lib/required-env.ts: a missing
# one FAILS a VERCEL_ENV=production build (scripts/check-required-env.ts, run
# from prebuild), and at runtime logs "[env] FATAL missing ..." and makes
# /api/health return 503 with the missing names. Hosted production =
# VERCEL_ENV=production, RENDER_SERVICE_ID, RAILWAY_ENVIRONMENT=production,
# FLY_APP_NAME or ORIGIN_DEPLOYMENT_ENV=production.
# Always required there: AUTH_JWT_SECRET_CURRENT, USER_DATABASE_URL,
# OGCODE_DATABASE_URL (or a fallback below), INTERNAL_CRON_TOKEN,
# UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN.
# ─────────────────────────────────────────────────────────────────────────────

# Database fallbacks and replica. The OGCode pool reads OGCODE_DATABASE_URL, then
# OGCODE_POSTGRES_URL, POSTGRES_URL, DATABASE_URL (first one set wins).
# OGCODE_POSTGRES_URL=<postgres-url>
# POSTGRES_URL=<postgres-url>
# DATABASE_URL=<postgres-url>
# Optional read replica for USER_DATABASE_URL reads.
USER_REPLICA_DATABASE_URL=
# Set to "true" to make the app store read the tasks collection from Postgres only.
# STORE_PG_ONLY_TASKS=false

# Vercel Cron signs its own scheduled calls with `Authorization: Bearer $CRON_SECRET`.
# The internal cron routes accept it alongside INTERNAL_CRON_TOKEN.
# REQUIRED in hosted production while TEACHER_LAUNCH_CONTEST is on.
CRON_SECRET=<32-plus-character-random-secret>

# CBT — signs student participant/report tokens. Min 32 chars.
# REQUIRED in hosted production while the CBT module is on (it is on by default).
CBT_PARTICIPANT_TOKEN_SECRET=<32-plus-character-random-secret>

# Contest + ORBIT — the contest-service worker (draft buffer, grading).
# REQUIRED in hosted production while TEACHER_LAUNCH_CONTEST is on.
CONTEST_SERVICE_URL=<contest-service-url>
CONTEST_SERVICE_TOKEN=<contest-service-token>
CONTEST_SERVICE_TIMEOUT_MS=<timeout-ms>
# Days after which a finished contest's answer partitions are reclaimed.
CONTEST_RETENTION_ARCHIVE_DAYS=<days>

# Origin NOW — REQUIRED in hosted production while TEACHER_LAUNCH_ORIGIN_NOW is on.
# KYC field encryption key: 32 random bytes, base64 (openssl rand -base64 32).
NOW_KYC_ENCRYPTION_KEY=<32-byte-base64-key>
# Private R2 bucket for uploads that must not be publicly readable.
R2_PRIVATE_BUCKET=<r2-private-bucket-name>
# LiveKit (NOW voice/video rooms).
LIVEKIT_URL=<livekit-url>
LIVEKIT_API_KEY=<livekit-api-key>
LIVEKIT_API_SECRET=<livekit-api-secret>
NOW_BOT_AGENT_NAME=<livekit-agent-name>
# NOW call recordings (fall back to the R2_* values above when unset).
NOW_RECORDING_R2_ENDPOINT=<r2-endpoint-url>
NOW_RECORDING_R2_BUCKET=<r2-bucket-name>
NOW_RECORDING_R2_ACCESS_KEY_ID=<r2-access-key-id>
NOW_RECORDING_R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
# Alternative name for R2_ENDPOINT (also read by the NOW recording config).
# R2_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com

# Upstash QStash — delayed callbacks (NOW timers, payment jobs).
QSTASH_TOKEN=<qstash-token>
QSTASH_CURRENT_SIGNING_KEY=<qstash-current-signing-key>
QSTASH_NEXT_SIGNING_KEY=<qstash-next-signing-key>

# Vercel log drain receiver (/api/internal/observability/drain). Without it the
# route rejects every delivery with 503. DRAIN_LOG_BODY=1 logs raw payloads (debug only).
DRAIN_SECRET=<vercel-log-drain-secret>
DRAIN_LOG_BODY=0

# Razorpay mode switch. "live" moves real money; anything else is test.
# Per-mode credentials (RAZORPAY_TEST_* / RAZORPAY_LIVE_*) take precedence over
# the flat RAZORPAY_KEY_ID / _KEY_SECRET / _WEBHOOK_SECRET above.
RAZORPAY_MODE=test
# RAZORPAY_TEST_KEY_ID=<razorpay-test-key-id>
# RAZORPAY_TEST_KEY_SECRET=<razorpay-test-key-secret>
# RAZORPAY_TEST_WEBHOOK_SECRET=<razorpay-test-webhook-secret>
# RAZORPAY_LIVE_KEY_ID=<razorpay-live-key-id>
# RAZORPAY_LIVE_KEY_SECRET=<razorpay-live-key-secret>
# RAZORPAY_LIVE_WEBHOOK_SECRET=<razorpay-live-webhook-secret>
# 1 = Razorpay Subscriptions (recurring) are enabled on the account.
RAZORPAY_SUBSCRIPTIONS_ENABLED=0

# Transactional email via Amazon SES SMTP (preferred over the SMTP_* block above
# when SES_SMTP_HOST is set).
SES_SMTP_HOST=<ses-smtp-host>
SES_SMTP_PORT=<ses-smtp-port>
SES_SMTP_USER=<ses-smtp-username>
SES_SMTP_PASS=<ses-smtp-password>
SES_EMAIL_FROM=<email-from>
# Email footer links (each has a built-in default).
EMAIL_SUPPORT_URL=<support-url>
EMAIL_SOCIAL_WHATSAPP=<whatsapp-community-url>
EMAIL_SOCIAL_LINKEDIN=<linkedin-url>
EMAIL_SOCIAL_X=<x-url>
EMAIL_SOCIAL_INSTAGRAM=<instagram-url>

# Android push (Firebase Cloud Messaging service account). Paste the private key
# with literal \n line breaks.
FCM_PROJECT_ID=<firebase-project-id>
FCM_CLIENT_EMAIL=<firebase-service-account-email>
FCM_PRIVATE_KEY=<firebase-service-account-private-key>

# WhatsApp notifications (BSP / Cloud API). Both unset = WhatsApp sends are skipped.
WHATSAPP_API_URL=<whatsapp-api-url>
WHATSAPP_API_TOKEN=<whatsapp-api-token>

# Google sign-in from the Android app (accepted alongside NEXT_PUBLIC_GOOGLE_CLIENT_ID).
GOOGLE_ANDROID_CLIENT_ID=<android-oauth-client-id>

# Option-shuffle fallback secrets (OPTION_SHUFFLE_SECRET above is preferred).
# AUTH_SECRET=<32-plus-character-random-secret>
# NEXTAUTH_SECRET=<32-plus-character-random-secret>

# Legacy single main-admin email (PLATFORM_MAIN_ADMIN_EMAIL above wins).
# MAIN_ADMIN_EMAIL=<admin-email>
# Teacher-code support phone shown to teachers (admin setting overrides it).
TEACHER_CODE_SUPPORT_PHONE=<support-phone>
# Teacher collaborations auto-approve (1) instead of waiting for an admin.
CONNECT_AUTO_APPROVE=0

# Tuning knobs (all optional; code defaults apply when unset).
AI_ACCESS_SNAPSHOT_TTL_MS=<ttl-ms>
INCIDENT_SNAPSHOT_TTL_MS=<ttl-ms>
ANALYTICS_SERVICE_CIRCUIT_FAILURES=<failure-count>
ANALYTICS_SERVICE_CIRCUIT_OPEN_MS=<open-ms>
GRADER_SERVICE_CIRCUIT_FAILURES=<failure-count>
GRADER_SERVICE_CIRCUIT_OPEN_MS=<open-ms>
DOCUMENT_IMPORT_WORKSPACE_CONCURRENCY=<max-concurrent-imports-per-workspace>
ORIGIN_GENERAL_RATE_LIMIT=<requests-per-window>
ORIGIN_MUTATION_RATE_LIMIT=<requests-per-window>
# "false" disables draining one analysis job inline after a submit.
ORIGIN_ANALYSIS_OPPORTUNISTIC_DRAIN=true
# Added to the public site-visits counter.
SITE_VISITS_BASELINE=0
# 1 re-enables the legacy demo seed data (dev only).
ORIGIN_ALLOW_DEMO_SEEDS=0

# Public (browser-exposed) settings.
NEXT_PUBLIC_ORIGIN_AI_SERVICE_URL=<origin-ai-public-url>
NEXT_PUBLIC_GA_ID=<google-analytics-id>
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=<search-console-token>
# Service worker: set 0 to disable it; 1 to also run it in `next dev`.
NEXT_PUBLIC_SW_ENABLED=1
NEXT_PUBLIC_SW_DEV=0

# Set by the platform, not by hand. Listed because the code reads them
# (ORIGIN_DEPLOYMENT_ENV=production marks a self-hosted production deploy).
# NODE_ENV=production
# VERCEL_ENV=production
# VERCEL_URL=<deployment-host>
# RENDER_SERVICE_ID=<render-service-id>
# RAILWAY_ENVIRONMENT=production
# FLY_APP_NAME=<fly-app-name>
# ORIGIN_DEPLOYMENT_ENV=production

# Feature flags: TEACHER_LAUNCH_<SUFFIX> = 1/0 (also true/false, on/off). Unset
# = the default shown. Source of truth: src/lib/feature-flags.ts. The runtime
# kill-switch at /admin/incidents overrides these without a redeploy.
# TEACHER_LAUNCH_WORKSPACES=   # workspaces: default dev=on, prod=on
# TEACHER_LAUNCH_ORG_CODES=   # orgCodes: default dev=on, prod=on
# TEACHER_LAUNCH_ENROLLMENT=   # enrollment: default dev=on, prod=on
# TEACHER_LAUNCH_BATCHES=   # batches: default dev=on, prod=on
# TEACHER_LAUNCH_QUESTION_BAG=   # questionBag: default dev=on, prod=on
# TEACHER_LAUNCH_TEACHER_TESTS=   # teacherTests: default dev=on, prod=on
# TEACHER_LAUNCH_TEACHER_ROOMS=   # teacherRooms: default dev=on, prod=on
# TEACHER_LAUNCH_STUDY_MATERIALS=   # studyMaterials: default dev=on, prod=on
# TEACHER_LAUNCH_TEACHER_ANALYTICS=   # teacherAnalytics: default dev=on, prod=on
# TEACHER_LAUNCH_TEACHER_DEEP_ANALYTICS=   # teacherDeepAnalytics: default dev=on, prod=on
# TEACHER_LAUNCH_OGCODE_PUBLISHING=   # ogcodePublishing: default dev=on, prod=on
# TEACHER_LAUNCH_DOCUMENT_IMPORT=   # documentImport: default dev=on, prod=on
# TEACHER_LAUNCH_ADMIN_CONTROL=   # adminControlCenter: default dev=on, prod=on
# TEACHER_LAUNCH_PAID_ENROLLMENT=   # paidEnrollment: default dev=on, prod=on
# TEACHER_LAUNCH_TEACHER_CONNECT=   # teacherConnect: default dev=on, prod=on
# TEACHER_LAUNCH_TEACHER_OGCODE=   # teacherOgcode: default dev=on, prod=on
# TEACHER_LAUNCH_CBT=   # cbtModule: default dev=on, prod=on
# TEACHER_LAUNCH_DPP_QUESTION_BANK=   # dppQuestionBank: default dev=on, prod=on
# TEACHER_LAUNCH_BATCH_SYLLABUS=   # batchSyllabus: default dev=on, prod=on
# TEACHER_LAUNCH_BATCH_HUB=   # batchHub: default dev=on, prod=on
# TEACHER_LAUNCH_INSTITUTE_APPROVAL_GATE=   # instituteApprovalGate: default dev=on, prod=on
# TEACHER_LAUNCH_OGCODE_HALLMARK=   # ogcodeHallmark: default dev=on, prod=on
# TEACHER_LAUNCH_ADMIN_PRICING=   # adminPricing: default dev=on, prod=on
# TEACHER_LAUNCH_ADMIN_COUPONS=   # adminCoupons: default dev=on, prod=on
# TEACHER_LAUNCH_ADMIN_SUB_ADMINS=   # adminSubAdmins: default dev=on, prod=on
# TEACHER_LAUNCH_ADMIN_PREMIUM_ACCESS=   # adminPremiumAccess: default dev=on, prod=on
# TEACHER_LAUNCH_AI_ACCESS_CONTROLS=   # aiAccessControls: default dev=on, prod=on
# TEACHER_LAUNCH_OGCODE_SCORING_V2=   # ogcodeScoringV2: default dev=off, prod=off
# TEACHER_LAUNCH_TEACHER_CODE_APPROVAL=   # teacherCodeApproval: default dev=on, prod=off
# TEACHER_LAUNCH_ADMIN_USER_LIFECYCLE=   # adminUserLifecycle: default dev=on, prod=off
# TEACHER_LAUNCH_STUDY_MODES=   # studyModes: default dev=on, prod=on
# TEACHER_LAUNCH_CBT_REPORT_CARDS=   # cbtReportCards: default dev=on, prod=on
# TEACHER_LAUNCH_TEACHER_DPP_SHARE=   # teacherDppShare: default dev=on, prod=on
# TEACHER_LAUNCH_CBT_PARTICIPATION_QUOTA=   # cbtParticipationQuota: default dev=on, prod=on
# TEACHER_LAUNCH_FULL_LENGTH_MOCKS=   # fullLengthMocks: default dev=on, prod=on
# TEACHER_LAUNCH_QUESTION_CLUSTERS=   # questionClusters: default dev=on, prod=on
# TEACHER_LAUNCH_CONTEST=   # contest: default dev=on, prod=off
# TEACHER_LAUNCH_CONTEST_QUESTION_TYPES=   # contestQuestionTypes: default dev=off, prod=off
# TEACHER_LAUNCH_CONTEST_PROCTORING=   # contestProctoring: default dev=off, prod=off
# TEACHER_LAUNCH_PAYMENTS=   # payments: default dev=off, prod=off
# TEACHER_LAUNCH_LOGIN_STREAK=   # loginStreakCelebration: default dev=on, prod=off
# TEACHER_LAUNCH_ORIGIN_NOW=   # originNow: default dev=off, prod=off
